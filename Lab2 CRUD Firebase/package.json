{
  "name": "lab2-crud-firebase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "dev:local": "node scripts/dev-local.mjs",
    "emulators": "node scripts/emulators.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/employee.test.ts",
    "test:firebase": "firebase emulators:exec --config firebase.test.json --project demo-lab2-tests --only firestore \"node --experimental-strip-types --test tests/firestore.test.ts\""
  },
  "dependencies": {
    "firebase": "12.19.0",
    "next": "16.3.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.7",
    "firebase-tools": "15.32.0",
    "typescript": "^5.9.3"
  }
}
